{
  "name": "sa-agent-desktop",
  "description": "Desktop client for SA-Agent.",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "AstAgency",
  "scripts": {
    "python:build": "node ./scripts/build-python-runtime.mjs",
    "python:rebuild": "SA_AGENT_REBUILD_PYTHON=1 node ./scripts/build-python-runtime.mjs",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:main": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on dist-electron/main.js dist-electron/preload.cjs tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "test:main": "tsc -p tsconfig.node.json && node --test dist-electron/**/*.test.js",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:main && npm run typecheck:tooling",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.json",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json",
    "build": "rimraf dist-electron dist tsconfig.node.tsbuildinfo && npm run typecheck && tsc -p tsconfig.node.json && vite build",
    "dist": "npm run build && electron-builder --config electron-builder.config.mjs --publish never"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^29.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "42.0.0",
    "electron-builder": "^26.0.12",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
